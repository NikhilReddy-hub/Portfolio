<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0c0a14"/>
      <stop offset="50%" stop-color="#181329"/>
      <stop offset="100%" stop-color="#09070f"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#6366f1"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.08"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#bgGrad)"/>
  
  <!-- Glowing Orbs -->
  <circle cx="200" cy="120" r="150" fill="#f59e0b" opacity="0.12" filter="blur(50px)"/>
  <circle cx="650" cy="320" r="180" fill="#6366f1" opacity="0.15" filter="blur(60px)"/>

  <!-- UI Window Container -->
  <rect x="60" y="50" width="680" height="350" rx="16" fill="url(#cardGrad)" stroke="#ffffff" stroke-opacity="0.15" stroke-width="1.5"/>
  
  <!-- Window Header Bar -->
  <rect x="60" y="50" width="680" height="40" rx="16" fill="#ffffff" fill-opacity="0.05"/>
  <circle cx="90" cy="70" r="6" fill="#ef4444" opacity="0.8"/>
  <circle cx="110" cy="70" r="6" fill="#eab308" opacity="0.8"/>
  <circle cx="130" cy="70" r="6" fill="#22c55e" opacity="0.8"/>
  <text x="400" y="75" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="13" text-anchor="middle" font-weight="500">skill-bridge-ai-rust.vercel.app</text>

  <!-- Dashboard Body -->
  <!-- Sidebar -->
  <rect x="80" y="110" width="160" height="270" rx="10" fill="#000000" fill-opacity="0.3" stroke="#ffffff" stroke-opacity="0.05"/>
  <rect x="100" y="130" width="120" height="12" rx="4" fill="url(#accentGrad)"/>
  <rect x="100" y="160" width="100" height="8" rx="3" fill="#ffffff" fill-opacity="0.3"/>
  <rect x="100" y="180" width="85" height="8" rx="3" fill="#ffffff" fill-opacity="0.2"/>
  <rect x="100" y="200" width="110" height="8" rx="3" fill="#ffffff" fill-opacity="0.2"/>
  <rect x="100" y="220" width="90" height="8" rx="3" fill="#ffffff" fill-opacity="0.2"/>
  <rect x="100" y="290" width="120" height="32" rx="8" fill="#f59e0b" fill-opacity="0.2" stroke="#f59e0b" stroke-opacity="0.4"/>
  <text x="160" y="311" fill="#f59e0b" font-family="system-ui, sans-serif" font-size="12" text-anchor="middle" font-weight="700">AI Roadmap</text>

  <!-- Main Content Card 1: Skill Radar / Stats -->
  <rect x="260" y="110" width="220" height="130" rx="10" fill="#000000" fill-opacity="0.4" stroke="#ffffff" stroke-opacity="0.08"/>
  <text x="280" y="138" fill="#ffffff" font-family="system-ui, sans-serif" font-size="14" font-weight="700">Skill Gap Analysis</text>
  <text x="280" y="156" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="11">Target Role: Full-Stack Engineer</text>

  <!-- Progress Bar 1 -->
  <text x="280" y="182" fill="#d1d5db" font-family="system-ui, sans-serif" font-size="11">React 19 & System Design</text>
  <rect x="280" y="188" width="180" height="6" rx="3" fill="#ffffff" fill-opacity="0.1"/>
  <rect x="280" y="188" width="150" height="6" rx="3" fill="#f59e0b"/>

  <!-- Progress Bar 2 -->
  <text x="280" y="210" fill="#d1d5db" font-family="system-ui, sans-serif" font-size="11">Java DSA & Prereqs (DAG)</text>
  <rect x="280" y="216" width="180" height="6" rx="3" fill="#ffffff" fill-opacity="0.1"/>
  <rect x="280" y="216" width="162" height="6" rx="3" fill="#6366f1"/>

  <!-- Main Content Card 2: AI Roadmap Nodes -->
  <rect x="500" y="110" width="220" height="270" rx="10" fill="#000000" fill-opacity="0.4" stroke="#ffffff" stroke-opacity="0.08"/>
  <text x="520" y="138" fill="#ffffff" font-family="system-ui, sans-serif" font-size="14" font-weight="700">Gemini Roadmap</text>

  <!-- Roadmap Steps -->
  <circle cx="530" cy="170" r="10" fill="#22c55e"/>
  <text x="530" y="174" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle">✓</text>
  <text x="550" y="174" fill="#ffffff" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Week 1: Resume Parsing</text>

  <line x1="530" y1="180" x2="530" y2="210" stroke="#22c55e" stroke-width="2"/>

  <circle cx="530" cy="220" r="10" fill="#f59e0b"/>
  <text x="530" y="224" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle">⚡</text>
  <text x="550" y="224" fill="#ffffff" font-family="system-ui, sans-serif" font-size="11" font-weight="600">Week 2: Heap & Prereqs</text>

  <line x1="530" y1="230" x2="530" y2="260" stroke="#ffffff" stroke-opacity="0.2" stroke-width="2" stroke-dasharray="4"/>

  <circle cx="530" cy="270" r="10" fill="#ffffff" fill-opacity="0.1" stroke="#ffffff" stroke-opacity="0.3"/>
  <text x="550" y="274" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="11">Week 3: Microservices</text>

  <rect x="520" y="310" width="180" height="50" rx="8" fill="#6366f1" fill-opacity="0.15" stroke="#6366f1" stroke-opacity="0.3"/>
  <text x="610" y="332" fill="#a5b4fc" font-family="system-ui, sans-serif" font-size="11" text-anchor="middle" font-weight="600">🔥 7 Day Streak · 850 XP</text>
  <text x="610" y="348" fill="#d1d5db" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle">Java Engine Active</text>

  <!-- Bottom Analytics Card -->
  <rect x="260" y="250" width="220" height="130" rx="10" fill="#000000" fill-opacity="0.4" stroke="#ffffff" stroke-opacity="0.08"/>
  <text x="280" y="278" fill="#ffffff" font-family="system-ui, sans-serif" font-size="14" font-weight="700">SkillBridge AI</text>
  <text x="280" y="298" fill="#f59e0b" font-family="system-ui, sans-serif" font-size="11" font-weight="600">React 19 · Node · Gemini · Java</text>
  <text x="280" y="318" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="10">PDF Parsing & DAG Ordering</text>
  <rect x="280" y="332" width="100" height="26" rx="6" fill="url(#accentGrad)"/>
  <text x="330" y="349" fill="#ffffff" font-family="system-ui, sans-serif" font-size="11" text-anchor="middle" font-weight="700">Live Demo →</text>
</svg>
