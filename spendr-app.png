<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="spendrBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#081017"/>
      <stop offset="50%" stop-color="#0f1f2e"/>
      <stop offset="100%" stop-color="#09070f"/>
    </linearGradient>
    <linearGradient id="spendrAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.08"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#spendrBg)"/>

  <!-- Glowing Orbs -->
  <circle cx="250" cy="350" r="160" fill="#10b981" opacity="0.15" filter="blur(60px)"/>
  <circle cx="600" cy="150" r="140" fill="#06b6d4" opacity="0.12" filter="blur(50px)"/>

  <!-- Desktop Browser Container -->
  <rect x="50" y="40" width="480" height="370" rx="14" fill="url(#cardBg)" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1.5"/>
  <rect x="50" y="40" width="480" height="36" rx="14" fill="#ffffff" fill-opacity="0.04"/>
  <circle cx="75" cy="58" r="5" fill="#ef4444" opacity="0.8"/>
  <circle cx="92" cy="58" r="5" fill="#eab308" opacity="0.8"/>
  <circle cx="109" cy="58" r="5" fill="#22c55e" opacity="0.8"/>
  <text x="290" y="62" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="12" text-anchor="middle">spendr-apps.netlify.app</text>

  <!-- Spendr Web App Dashboard Content -->
  <rect x="75" y="95" width="200" height="90" rx="10" fill="#000000" fill-opacity="0.4" stroke="#ffffff" stroke-opacity="0.06"/>
  <text x="95" y="120" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="11">Total Balance</text>
  <text x="95" y="148" fill="#ffffff" font-family="system-ui, sans-serif" font-size="22" font-weight="800">$12,450.80</text>
  <text x="95" y="170" fill="#10b981" font-family="system-ui, sans-serif" font-size="10" font-weight="600">+14.2% this month</text>

  <rect x="290" y="95" width="220" height="90" rx="10" fill="#000000" fill-opacity="0.4" stroke="#ffffff" stroke-opacity="0.06"/>
  <text x="310" y="120" fill="#9ca3af" font-family="system-ui, sans-serif" font-size="11">Monthly Spending</text>
  <text x="310" y="148" fill="#f43f5e" font-family="system-ui, sans-serif" font-size="22" font-weight="800">$2,180.40</text>
  <text x="310" y="170" fill="#6b7280" font-family="system-ui, sans-serif" font-size="10">Offline-First Synced</text>

  <!-- Analytics Line Graph Mockup -->
  <rect x="75" y="200" width="435" height="190" rx="10" fill="#000000" fill-opacity="0.4" stroke="#ffffff" stroke-opacity="0.06"/>
  <text x="95" y="225" fill="#ffffff" font-family="system-ui, sans-serif" font-size="13" font-weight="700">Financial Analytics & Expense Breakdown</text>
  
  <path d="M 95 350 Q 150 320, 200 330 T 300 270 T 400 290 T 490 240" fill="none" stroke="url(#spendrAccent)" stroke-width="3"/>
  <path d="M 95 350 Q 150 320, 200 330 T 300 270 T 400 290 T 490 240 L 490 360 L 95 360 Z" fill="url(#spendrAccent)" opacity="0.15"/>

  <!-- Mobile Device Frame Mockup (Right Side Overlay) -->
  <rect x="560" y="30" width="190" height="390" rx="28" fill="#0c1622" stroke="#ffffff" stroke-opacity="0.25" stroke-width="2.5"/>
  <rect x="625" y="42" width="60" height="10" rx="5" fill="#1f2937"/>
  
  <!-- Mobile Screen Content -->
  <rect x="572" y="60" width="166" height="345" rx="18" fill="#090d14"/>
  <text x="655" y="85" fill="#ffffff" font-family="system-ui, sans-serif" font-size="13" text-anchor="middle" font-weight="700">Spendr Mobile</text>
  
  <rect x="584" y="100" width="142" height="65" rx="10" fill="url(#spendrAccent)"/>
  <text x="596" y="120" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" opacity="0.9">React Native (Expo)</text>
  <text x="596" y="142" fill="#ffffff" font-family="system-ui, sans-serif" font-size="16" font-weight="800">$4,850.00</text>
  
  <!-- Mobile Transaction List -->
  <rect x="584" y="175" width="142" height="35" rx="6" fill="#111827"/>
  <circle cx="600" cy="192.5" r="8" fill="#10b981" opacity="0.2"/>
  <text x="616" y="196" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" font-weight="600">Grocery Store</text>
  <text x="714" y="196" fill="#f43f5e" font-family="system-ui, sans-serif" font-size="10" font-weight="700" text-anchor="end">-$84.20</text>

  <rect x="584" y="218" width="142" height="35" rx="6" fill="#111827"/>
  <circle cx="600" cy="235.5" r="8" fill="#06b6d4" opacity="0.2"/>
  <text x="616" y="239" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" font-weight="600">Freelance Pay</text>
  <text x="714" y="239" fill="#10b981" font-family="system-ui, sans-serif" font-size="10" font-weight="700" text-anchor="end">+$1,200</text>

  <rect x="584" y="261" width="142" height="35" rx="6" fill="#111827"/>
  <circle cx="600" cy="278.5" r="8" fill="#f59e0b" opacity="0.2"/>
  <text x="616" y="282" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" font-weight="600">Coffee Shop</text>
  <text x="714" y="282" fill="#f43f5e" font-family="system-ui, sans-serif" font-size="10" font-weight="700" text-anchor="end">-$5.50</text>

  <rect x="584" y="310" width="142" height="30" rx="8" fill="#10b981" opacity="0.2" stroke="#10b981" stroke-opacity="0.4"/>
  <text x="655" y="329" fill="#34d399" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle" font-weight="700">AsyncStorage Ready</text>
</svg>
